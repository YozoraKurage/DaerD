.ce-toolbar {
    flex-direction: row;
    align-items: center;
}

/* Right-side toolbar controls. Unity's default ToolbarToggle wraps its text in an inner
   Label element while ToolbarButton renders text directly, so the two land the text on
   slightly different baselines and the row reads as ragged. Normalise: centre every item
   vertically, and pin any nested label to the same middle-centre alignment with no extra
   padding/margin so the caret sits at the same y as the button-only items. */
.dd-toolbar-item {
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
}

.dd-toolbar-item .unity-label,
.dd-toolbar-item .unity-text-element {
    -unity-text-align: middle-center;
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
}

/* Graph grid background: noticeably brighter than Unity's stock so the user can read
   distances and stay oriented while dragging. Minor lines are subtle; major lines (every
   10th line) are stronger so they read as anchors when the view is zoomed out. */
GridBackground {
    --grid-background-color: rgb(36, 36, 36);
    --line-color: rgba(170, 170, 170, 0.12);
    --thick-line-color: rgba(170, 170, 170, 0.32);
    --spacing: 20;
}

.ce-breadcrumb {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

/* Controller tabs: one row (wrapping if there are many) under the toolbar. */
.dd-tabbar {
    flex-direction: row;
    flex-wrap: wrap;
    background-color: rgba(0, 0, 0, 0.18);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.4);
    padding: 2px 2px 0 2px;
}

.dd-tab {
    flex-direction: row;
    align-items: center;
    padding: 2px 4px 2px 8px;
    margin-right: 2px;
    margin-bottom: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    background-color: rgba(255, 255, 255, 0.05);
}

.dd-tab--active {
    background-color: rgba(90, 140, 210, 0.55);
}

.dd-tab__label {
    -unity-font-style: bold;
    margin-right: 4px;
}

.dd-tab__close {
    width: 16px;
    -unity-text-align: middle-center;
    color: rgb(200, 200, 200);
    border-radius: 8px;
}

.dd-tab__close:hover {
    background-color: rgba(255, 80, 80, 0.6);
    color: rgb(255, 255, 255);
}

/* Inline rename field shown in place of a state node's name / motion label. */
.compact-node__rename {
    flex-grow: 1;
    margin: 0;
    font-size: 11px;
}

.ce-empty-hint {
    flex-grow: 1;
    -unity-text-align: middle-center;
    color: rgb(150, 150, 150);
    white-space: normal;
}

/* Compact node form shared by state and Entry/Exit/Any State nodes: no title bar,
   small left/right ports, a fixed width, and the name centred in a text column. No
   min-height on the outer element — that let the border sit noticeably taller than
   the two-line text and exposed a strip of node background below the motion label.
   Node height is now driven by content (special nodes pin #node-border below). */
.compact-node {
    width: 180px;
}

.compact-node #title {
    display: none;
}

.compact-node #divider {
    display: none;
}

/* The stock extension (#bottom / extensionContainer) has no children on either node
   type. RefreshExpandedState() usually hides it, but on some Unity versions the empty
   container still contributes a few pixels below the port row — drop it outright. */
.compact-node #extension {
    display: none;
}

.compact-node #input,
.compact-node #output {
    flex-grow: 0;
    justify-content: center;
}

/* Small ports: drop the tall fixed port height so the connectors take little room. */
.compact-node .port {
    height: auto;
    min-height: 0;
    padding-top: 2px;
    padding-bottom: 2px;
}

/* State node body + port columns are painted one opaque colour from StateNode.cs (so play-mode
   "current state" green can override it); the connector dots keep their own styling. */

/* flex-shrink lets the text column give way so a long name truncates instead of
   widening the node past its fixed width. */
.compact-node__text {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    justify-content: center;
    padding: 4px 6px;
}

.compact-node__name {
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.compact-node__motion {
    font-size: 10px;
    color: rgb(175, 175, 175);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Entry / Exit / Any State carry no motion line, so the name label is enlarged and
   stretched to fill the node as a solid colour block. */
.special-node .compact-node__text {
    padding: 2px;
}

.special-node .compact-node__name {
    flex-grow: 1;
    font-size: 14px;
}

/* Stretch the content row to the full node height so text centres vertically — otherwise
   #top only takes its natural size and the two-line text (name + motion) hugs the top,
   leaving a strip of node background exposed below. For special nodes, this also lets the
   name label's colour block reach the full height. */
.compact-node #contents,
.compact-node #top {
    flex-grow: 1;
}

/* The single-line special nodes leave node-border shorter (≈28px) than the selection outline,
   so it doesn't match the (taller, two-line) state nodes. Pin it to the state-node height. */
.special-node #node-border {
    min-height: 38px;
}

.ssm-node {
    min-width: 140px;
}

/* One-line condition summary drawn next to a single-transition edge. */
.transition-edge__label {
    position: absolute;
    width: 140px;
    color: rgb(190, 190, 190);
    font-size: 10px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Badges on state nodes: WD (Write Defaults) and B (behaviours). Tiny text overlaid
   in the top-right corner so the node keeps its compact two-line layout. Always
   visible; StateNode colours them lit when active and grey when not. */
.state-node__badges {
    position: absolute;
    top: 1px;
    right: 4px;
    flex-direction: row;
}

.state-node__badge {
    font-size: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-left: 3px;
    padding: 0;
}

/* Graph frames (comment / group boxes drawn behind nodes). */
.dd-frame__title {
    flex-direction: row;
    align-items: center;
    padding-left: 6px;
}

.dd-frame__title-label {
    flex-grow: 1;
    -unity-font-style: bold;
    color: rgb(235, 235, 235);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Inspector-style lock toggle at the right end of the title bar. */
.dd-frame__lock {
    width: 16px;
    height: 16px;
    margin-right: 4px;
    flex-shrink: 0;
    opacity: 0.75;
}

.dd-frame__lock:hover {
    opacity: 1;
}

/* Square resize handles shown on the edges and corners of a selected frame / note. */
.dd-resize-handle {
    position: absolute;
    width: 9px;
    height: 9px;
    background-color: rgb(102, 179, 255);
    border-width: 1px;
    border-color: rgb(25, 25, 25);
}

.dd-resize-handle--nw { left: -5px; top: -5px; cursor: resize-up-left; }
.dd-resize-handle--n { left: 50%; margin-left: -5px; top: -5px; cursor: resize-vertical; }
.dd-resize-handle--ne { right: -5px; top: -5px; cursor: resize-up-right; }
.dd-resize-handle--w { left: -5px; top: 50%; margin-top: -5px; cursor: resize-horizontal; }
.dd-resize-handle--e { right: -5px; top: 50%; margin-top: -5px; cursor: resize-horizontal; }
.dd-resize-handle--sw { left: -5px; bottom: -5px; cursor: resize-up-right; }
.dd-resize-handle--s { left: 50%; margin-left: -5px; bottom: -5px; cursor: resize-vertical; }
.dd-resize-handle--se { right: -5px; bottom: -5px; cursor: resize-up-left; }

/* Inline rename field shown in place of a frame's title label. */
.dd-frame__rename {
    flex-grow: 1;
    margin: 2px 4px;
}

/* Memo notes (sticky notes drawn among the nodes). */
.dd-note {
    border-radius: 3px;
    padding: 5px 6px;
    min-width: 80px;
    min-height: 40px;
}

.dd-note__text {
    color: rgb(38, 34, 22);
    white-space: normal;
    flex-grow: 1;
}

/* In-place note editing field. The TextField wraps its content via the inner input
   element — without explicit white-space the line just clips when it overflows. */
.dd-note__edit {
    flex-grow: 1;
    margin: 0;
}

.dd-note__edit > .unity-text-input,
.dd-note__edit .unity-base-text-field__input {
    white-space: normal;
    flex-grow: 1;
}

.transition-edge__badge {
    position: absolute;
    background-color: rgb(40, 40, 40);
    border-color: rgb(120, 120, 120);
    border-width: 1px;
    border-radius: 8px;
    color: rgb(255, 255, 255);
    font-size: 10px;
    -unity-text-align: middle-center;
    min-width: 16px;
    height: 16px;
    padding-left: 3px;
    padding-right: 3px;
}

.ce-panel {
    flex-grow: 1;
}

.ce-panel__header {
    -unity-font-style: bold;
    padding: 4px 6px;
    background-color: rgba(0, 0, 0, 0.2);
}

/* Blend tree view: roomier nodes than the state machine view because every node
   carries 2-3 lines of metadata. */
.blendtree-root-node {
    min-width: 200px;
}

.blendtree-child-node {
    min-width: 200px;
}

.blendtree-node__meta {
    -unity-font-style: bold;
    font-size: 11px;
}
