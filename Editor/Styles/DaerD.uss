.ce-toolbar {
    flex-direction: row;
    align-items: center;
}

.ce-breadcrumb {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

/* Controller tabs: one row (wrapping if there are many) under the toolbar. */
.dd-tabbar {
    flex-direction: row;
    flex-wrap: wrap;
    background-color: rgba(0, 0, 0, 0.18);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.4);
    padding: 2px 2px 0 2px;
}

.dd-tab {
    flex-direction: row;
    align-items: center;
    padding: 2px 4px 2px 8px;
    margin-right: 2px;
    margin-bottom: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    background-color: rgba(255, 255, 255, 0.05);
}

.dd-tab--active {
    background-color: rgba(90, 140, 210, 0.55);
}

.dd-tab__label {
    -unity-font-style: bold;
    margin-right: 4px;
}

.dd-tab__close {
    width: 16px;
    -unity-text-align: middle-center;
    color: rgb(200, 200, 200);
    border-radius: 8px;
}

.dd-tab__close:hover {
    background-color: rgba(255, 80, 80, 0.6);
    color: rgb(255, 255, 255);
}

/* Inline rename field shown in place of a state node's name / motion label. */
.compact-node__rename {
    flex-grow: 1;
    margin: 0;
    font-size: 11px;
}

.ce-empty-hint {
    flex-grow: 1;
    -unity-text-align: middle-center;
    color: rgb(150, 150, 150);
    white-space: normal;
}

/* Compact node form shared by state and Entry/Exit/Any State nodes: no title bar,
   small left/right ports, a fixed width, and the name centred in a text column. */
.compact-node {
    width: 180px;
    min-height: 46px;
}

.compact-node #title {
    display: none;
}

.compact-node #divider {
    display: none;
}

.compact-node #input,
.compact-node #output {
    flex-grow: 0;
    justify-content: center;
}

/* Small ports: drop the tall fixed port height so the connectors take little room. */
.compact-node .port {
    height: auto;
    min-height: 0;
    padding-top: 2px;
    padding-bottom: 2px;
}

/* State node body + port columns are painted one opaque colour from StateNode.cs (so play-mode
   "current state" green can override it); the connector dots keep their own styling. */

/* flex-shrink lets the text column give way so a long name truncates instead of
   widening the node past its fixed width. */
.compact-node__text {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    justify-content: center;
    padding: 4px 6px;
}

.compact-node__name {
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.compact-node__motion {
    font-size: 10px;
    color: rgb(175, 175, 175);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Entry / Exit / Any State carry no motion line, so the name label is enlarged and
   stretched to fill the node as a solid colour block. */
.special-node .compact-node__text {
    padding: 2px;
}

.special-node .compact-node__name {
    flex-grow: 1;
    font-size: 14px;
}

/* The name label only fills the node (as the comment above intends) if its containers stretch
   too; otherwise a strip of node background shows below it. Stretch the content row so the
   colour block reaches the full node height — no leftover space at the bottom. */
.special-node #contents,
.special-node #top {
    flex-grow: 1;
}

/* The single-line special nodes leave node-border shorter (≈28px) than the selection outline,
   so it doesn't match the (taller, two-line) state nodes. Pin it to the state-node height. */
.special-node #node-border {
    min-height: 38px;
}

.ssm-node {
    min-width: 140px;
}

/* One-line condition summary drawn next to a single-transition edge. */
.transition-edge__label {
    position: absolute;
    width: 140px;
    color: rgb(190, 190, 190);
    font-size: 10px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Badges on state nodes: WD (Write Defaults) and B (behaviours). Tiny text overlaid
   in the top-right corner so the node keeps its compact two-line layout. Always
   visible; StateNode colours them lit when active and grey when not. */
.state-node__badges {
    position: absolute;
    top: 1px;
    right: 4px;
    flex-direction: row;
}

.state-node__badge {
    font-size: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-left: 3px;
    padding: 0;
}

/* Graph frames (comment / group boxes drawn behind nodes). */
.dd-frame__title {
    justify-content: center;
    padding-left: 6px;
}

.dd-frame__title-label {
    -unity-font-style: bold;
    color: rgb(235, 235, 235);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.transition-edge__badge {
    position: absolute;
    background-color: rgb(40, 40, 40);
    border-color: rgb(120, 120, 120);
    border-width: 1px;
    border-radius: 8px;
    color: rgb(255, 255, 255);
    font-size: 10px;
    -unity-text-align: middle-center;
    min-width: 16px;
    height: 16px;
    padding-left: 3px;
    padding-right: 3px;
}

.ce-panel {
    flex-grow: 1;
}

.ce-panel__header {
    -unity-font-style: bold;
    padding: 4px 6px;
    background-color: rgba(0, 0, 0, 0.2);
}

/* Blend tree view: roomier nodes than the state machine view because every node
   carries 2-3 lines of metadata. */
.blendtree-root-node {
    min-width: 200px;
}

.blendtree-child-node {
    min-width: 200px;
}

.blendtree-node__meta {
    -unity-font-style: bold;
    font-size: 11px;
}
