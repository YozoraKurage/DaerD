msgstr "追加 ({0})"

msgid "Remove ({0})"
msgstr "削除 ({0})"

msgid "Already in sync — applying only reorders entries."
msgstr "既に同期済みです。適用すると並び順のみ整列されます。"

msgid "Apply"
