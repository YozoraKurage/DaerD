msgid "VRC Parameters"
msgstr "VRC パラメーター"

msgid "Sync"
msgstr "同期"

msgid "Network synced (costs bits)"
msgstr "ネットワーク同期（bit を消費）"

msgid "Saved between worlds"
msgstr "ワールド間で保存"

msgid "Add to the VRC expression parameters asset"
msgstr "VRC Expression Parameters アセットに追加します"

msgid "Rename Parameter Family"
