msgid "Expression parameters use {0} of {1} synced bits."
msgstr "Expression Parameters が同期ビットを {0} / {1} 使用しています。"

msgid "Expression parameter '{0}' has no matching controller parameter."
msgstr "Expression パラメーター '{0}' に対応するコントローラーのパラメーターがありません。"

msgid "Expression parameter '{0}' is {1} while the controller parameter is {2} — VRChat converts between them (parameter mismatching); make sure it's intentional."
msgstr "Expression パラメーター '{0}' は {1} 型、コントローラー側は {2} 型です。VRChat が相互変換するため動作します（パラメーターミスマッチング）。意図した組み合わせか確認してください。"

# ---- VRC behaviours ----

msgid "Paste"
msgstr "貼り付け"

msgid "Copy every behaviour on this state; paste from a state's right-click menu or here."
msgstr "この State の全 Behaviour をコピーします。State の右クリックメニューかここから貼り付けできます。"

msgid "Copy the selected behaviours; paste from a state's right-click menu or here."
msgstr "選択中の Behaviour をコピーします。State の右クリックメニューかここから貼り付けできます。"

msgid "Append the copied behaviours to this state."
msgstr "コピーした Behaviour をこの State に追加します。"

msgid "Click a title to select (Ctrl / Shift for multi-select); Ctrl+C / Ctrl+V copies and pastes the selected behaviours."
msgstr "タイトルをクリックで選択（Ctrl / Shift で複数選択）。選択中は Ctrl+C / Ctrl+V で Behaviour をコピー / 貼り付けします。"

msgid "Copy one instance of every behaviour found on the selected states."
msgstr "選択中の State にある Behaviour を種類ごとに 1 つコピーします。"

msgid "Append the copied behaviours to every selected state."
msgstr "コピーした Behaviour を選択中の全 State に追加します。"

msgid "None of the selected states have behaviours."
msgstr "選択中の State に Behaviour はありません。"

msgid "Edits apply to every selected state that has the behaviour. Click a title to select (Ctrl / Shift for multi-select); Ctrl+C / Ctrl+V copies and pastes."
msgstr "編集内容は、その Behaviour を持つ選択中の全 State に適用されます。タイトルをクリックで選択（Ctrl / Shift で複数選択）、Ctrl+C / Ctrl+V でコピー / 貼り付け。"

msgid "Copy this behaviour onto the selected states that don't have it."
msgstr "この Behaviour を、持っていない選択中の State にコピーします。"

msgid "Remove All"
