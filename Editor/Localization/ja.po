# ---- toolbar ----

msgid "Select Sync"
msgstr "選択同期"

msgid "Sync the Animation window's clip to the selected State's AnimationClip"
msgstr "選択した State の AnimationClip を Animation ウィンドウに同期します"

msgid "Preview"
msgstr "プレビュー"

msgid "Auto-toggle the Animation window's Preview on clip change. Implies Select Sync. Requires a scene GameObject with an Animator running this controller to be selected — Unity's preview can't run without a target."
msgstr "クリップ切り替え時に Animation ウィンドウの Preview を自動で入れ直します。選択同期も同時に ON になります。このコントローラーを実行する Animator を持つシーン上の GameObject を選択している必要があります。"

msgid "Frame All"
msgstr "全体表示"

msgid "Analyze"
msgstr "解析"

msgid "Settings"
msgstr "設定"

msgid "Search states (name or motion)"
msgstr "State 検索（名前 / モーション名）"

msgid "No matches."
msgstr "一致するものがありません。"

msgid "Close tab"
msgstr "タブを閉じる"

# ---- analyzer categories ----

msgid "Unused Parameter"
msgstr "未使用パラメーター"

msgid "Invalid Condition"
msgstr "無効な条件"

msgid "Dead Transition"
msgstr "発火しない遷移"

msgid "Soloed Transition"
msgstr "Solo された遷移"

msgid "Unreachable State"
msgstr "到達不能 State"

msgid "Duplicate Name"
msgstr "名前の重複"

msgid "Terminal States"
msgstr "行き止まり State"

msgid "WriteDefaults"
msgstr "Write Defaults 混在"

msgid "Missing Motion"
msgstr "モーション未設定"

msgid "Empty Layer"
msgstr "空のレイヤー"

msgid "Layer Weight"
msgstr "レイヤーウェイト"

msgid "Missing Behaviour"
msgstr "Behaviour 参照切れ"

msgid "Duplicate Condition"
msgstr "条件の重複"

msgid "Direct Blend Tree"
msgstr "Direct Blend Tree"

# ---- analyzer messages ----

msgid "Parameter '{0}' is never referenced."
msgstr "パラメーター '{0}' はどこからも参照されていません。"

msgid "Condition references missing parameter '{0}'."
msgstr "条件が存在しないパラメーター '{0}' を参照しています。"

msgid "Mode '{0}' is invalid for {1} parameter '{2}'."
msgstr "モード '{0}' は {1} 型パラメーター '{2}' に対して無効です。"

msgid "Transition {0} has no conditions and no exit time; it can never fire."
msgstr "遷移 {0} には条件も Exit Time もないため、発火することがありません。"

msgid "'{0}' has a soloed transition, so its other {1} transition(s) never run."
msgstr "'{0}' には Solo された遷移があるため、他の {1} 本は評価されません。"

msgid "Clear Solo"
msgstr "Solo を解除"

msgid "Turn Solo off on every transition leaving this node"
msgstr "このノードから出る全ての遷移の Solo を解除します"

msgid "State '{0}' has no incoming transition and is not a default state."
msgstr "State '{0}' には入ってくる遷移がなく、Default State でもありません。"

msgid "State '{0}' is only reachable from states that are themselves unreachable."
msgstr "State '{0}' に入れるのは、それ自体が到達不能な State からだけです。"

msgid "State name '{0}' is used more than once in '{1}'."
msgstr "State 名 '{0}' が '{1}' 内で複数回使われています。"

msgid "Layer '{0}': once entered, '{1}' can never be left (no outgoing transition or exit)."
msgstr "レイヤー '{0}': 一度 '{1}' に入ると抜け出せません（外向きの遷移も Exit もありません）。"

msgid "Layer '{0}' mixes Write Defaults ON and OFF across its states."
msgstr "レイヤー '{0}' の State で Write Defaults の ON と OFF が混在しています。"

msgid "State '{0}' has no motion assigned."
msgstr "State '{0}' にモーションが設定されていません。"

msgid "State '{0}' has Write Defaults OFF and no motion; animated properties freeze at their last value while it plays."
msgstr "State '{0}' は Write Defaults が OFF なのにモーションが未設定です。再生中、アニメーション対象のプロパティが直前の値のまま固まります。"

msgid "Blend tree '{0}' in state '{1}' has a child slot with no motion."
msgstr "State '{1}' の Blend Tree '{0}' にモーション未設定の子スロットがあります。"

msgid "Layer '{0}' contains no states."
msgstr "レイヤー '{0}' に State がありません。"

msgid "Layer '{0}' has default weight 0; it has no effect until its weight is raised at runtime."
msgstr "レイヤー '{0}' のデフォルトウェイトが 0 のため、実行時にウェイトを上げるまで効果がありません。"

msgid "State '{0}' has a missing (null) behaviour script."
msgstr "State '{0}' に参照が壊れた（null の）Behaviour があります。"

msgid "State machine '{0}' has a missing (null) behaviour script."
msgstr "State Machine '{0}' に参照が壊れた（null の）Behaviour があります。"

msgid "Transition {0} has duplicate conditions."
msgstr "遷移 {0} に同じ内容の条件が重複しています。"

msgid "State '{0}' plays a Direct blend tree but has Write Defaults OFF."
msgstr "State '{0}' は Direct Blend Tree を再生しますが、Write Defaults が OFF です。"

msgid "Direct blend tree '{0}' has a child with no weight parameter; that child never plays."
msgstr "Direct Blend Tree '{0}' にウェイトパラメーター未設定の子があります。その子は再生されません。"

msgid "Direct blend tree '{0}' weights a child with missing parameter '{1}'."
msgstr "Direct Blend Tree '{0}' の子が、存在しないパラメーター '{1}' をウェイトに使用しています。"

msgid "Weight parameter '{1}' of Direct blend tree '{0}' is not a Float."
msgstr "Direct Blend Tree '{0}' のウェイトパラメーター '{1}' が Float ではありません。"

# ---- analyzer fixes ----

msgid "Delete"
msgstr "削除"

msgid "Fix"
msgstr "修正"

msgid "Fill"
msgstr "穴埋め"

msgid "Delete this unused parameter"
msgstr "この未使用パラメーターを削除します"

msgid "Delete this transition"
msgstr "この遷移を削除します"

msgid "Remove the duplicate conditions"
msgstr "重複している条件を取り除きます"

msgid "Remove the missing behaviour entries"
msgstr "参照が壊れた Behaviour エントリを取り除きます"

msgid "Turn Write Defaults ON for this state"
msgstr "この State の Write Defaults を ON にします"

msgid "Assign this controller's Empty clip"
msgstr "このコントローラーの Empty クリップを割り当てます"

msgid "Fill the empty child slots with this controller's Empty clip"
msgstr "モーション未設定の子スロットにこのコントローラーの Empty クリップを割り当てます"

# ---- home screen ----

msgid "Home"
msgstr "ホーム"

msgid "Open Home"
msgstr "ホームを開く"

msgid "Gadgets, sync setups and tools for this controller live in the Home screen."
msgstr "ガジェット・巡回同期の設定・各種ツールはホーム画面にまとまっています。"

msgid "{0} layers · {1} parameters"
msgstr "レイヤー {0} 個 · パラメーター {1} 個"

msgid "The VRC Expressions Menu this controller belongs to, opened by the menu editor. Assigned explicitly — DaerD never guesses it from the scene."
msgstr "このコントローラーが属する VRC Expressions Menu。メニューエディターが開く対象です。明示的に指定するもので、DaerD がシーンから推測することはありません。"

msgid "DBT Gadgets"
msgstr "DBT ガジェット"

msgid "No gadgets yet."
msgstr "ガジェットはまだありません。"

msgid "Edit"
msgstr "編集"

msgid "+ Add Gadget"
msgstr "+ ガジェットを追加"

msgid "Add a Direct blend tree gadget that computes a float operation every frame."
msgstr "Float 演算を毎フレーム計算する Direct Blend Tree ガジェットを追加します。"

msgid "No async sync setups yet."
msgstr "巡回同期の設定はまだありません。"

msgid "{0} target(s), {1}s step"
msgstr "対象 {0} 件 / ステップ間隔 {1} 秒"

msgid "+ New Async Sync"
msgstr "+ 巡回同期を新規作成"

msgid "C# Recipes"
msgstr "C# レシピ"

msgid "No recipe-owned layers."
msgstr "レシピが生成したレイヤーはありません。"

msgid "Tools"
msgstr "ツール"

msgid "Window"
msgstr "ウィンドウ"

msgid "Open this tool in a window of its own, so it stays visible while you edit the graph."
msgstr "このツールを独立したウィンドウで開きます。グラフを編集している間も表示したままにできます。"

msgid "Clips"
msgstr "クリップ"

msgid "Analyzer"
msgstr "解析"

msgid "Recipe Export"
msgstr "レシピ書き出し"

msgid "The menu editor works on the avatar's menu tree, in a window of its own."
msgstr "メニューエディターはアバターのメニュー階層を編集するため、独立したウィンドウで開きます。"

msgid "Open Menu Editor"
msgstr "メニューエディターを開く"

